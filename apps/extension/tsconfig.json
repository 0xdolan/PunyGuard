{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src/**/*",
    "tests/**/*",
    "../../packages/core/src/**/*.d.ts",
    "wxt.config.ts",
    "vitest.config.ts"
  ]
}
