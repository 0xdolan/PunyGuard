{
  "name": "@punyguard/extension",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "PunyGuard browser extension: local IDN homograph & phishing lookalike detection",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:all": "pnpm build && pnpm build:edge && pnpm build:firefox && pnpm build:safari",
    "zip": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox && pnpm zip:safari",
    "safari:xcode": "pnpm build:safari && sh scripts/safari-convert.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.2.5",
    "@fontsource/noto-sans": "^5.3.0",
    "@punyguard/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "punycode": "^2.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "unicode-properties": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/punycode": "^2.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@wxt-dev/module-react": "^1.1.3",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
