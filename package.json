{
  "name": "punyguard",
  "version": "0.0.2",
  "private": true,
  "description": "Local-first IDN homograph & phishing lookalike detection for Chrome, Edge, Brave, Firefox, and Safari",
  "license": "GPL-3.0-or-later",
  "author": "0xdolan",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @punyguard/extension dev",
    "build": "pnpm --filter @punyguard/extension build",
    "build:edge": "pnpm --filter @punyguard/extension build:edge",
    "build:firefox": "pnpm --filter @punyguard/extension build:firefox",
    "build:safari": "pnpm --filter @punyguard/extension build:safari",
    "build:all": "pnpm --filter @punyguard/extension build:all",
    "test": "pnpm --filter @punyguard/extension test",
    "test:e2e": "pnpm --filter @punyguard/extension test:e2e",
    "lint": "pnpm --filter @punyguard/extension lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md,html,yml,yaml}\"",
    "site:dev": "pnpm --filter @punyguard/site dev",
    "site:build": "pnpm --filter @punyguard/site build",
    "site:preview": "pnpm site:build && pnpm --filter @punyguard/site preview",
    "zip": "pnpm --filter @punyguard/extension zip",
    "zip:edge": "pnpm --filter @punyguard/extension zip:edge",
    "zip:firefox": "pnpm --filter @punyguard/extension zip:firefox",
    "zip:safari": "pnpm --filter @punyguard/extension zip:safari",
    "zip:all": "pnpm --filter @punyguard/extension zip:all",
    "safari:xcode": "pnpm --filter @punyguard/extension safari:xcode",
    "version:check": "node scripts/version-check.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "verify": "pnpm install --frozen-lockfile && pnpm format:check && pnpm version:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm zip:all && pnpm lint:amo && pnpm site:build",
    "lint:amo": "npx --yes web-ext@8 lint --source-dir apps/extension/.output/firefox-mv3"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "^4.5.2"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xdolan/PunyGuard.git"
  },
  "homepage": "https://0xdolan.github.io/PunyGuard/",
  "bugs": "https://github.com/0xdolan/PunyGuard/issues"
}
